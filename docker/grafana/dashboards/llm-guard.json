{
  "uid": "llm-guard-v2",
  "title": "LLM Guard — 实时安全监控",
  "description": "Prompt注入 & 有害内容拦截全链路可观测",
  "tags": ["llm", "security", "guard"],
  "timezone": "browser",
  "refresh": "5s",
  "schemaVersion": 38,
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "请求总量",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "area", "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "blue", "value": null }
          ] },
          "unit": "short", "displayName": "Total Requests"
        }
      },
      "targets": [{ "expr": "llmguard_requests_total", "legendFormat": "requests", "datasource": "Prometheus" }]
    },
    {
      "id": 2, "type": "stat", "title": "已拦截",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }
          ] },
          "unit": "short", "displayName": "Blocked"
        }
      },
      "targets": [{ "expr": "llmguard_blocked_total", "legendFormat": "blocked", "datasource": "Prometheus" }]
    },
    {
      "id": 3, "type": "stat", "title": "1分钟拦截率",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.3 },
            { "color": "red", "value": 0.5 }
          ] }
        }
      },
      "targets": [{ "expr": "llmguard_block_ratio_1m", "legendFormat": "block ratio", "datasource": "Prometheus" }]
    },
    {
      "id": 4, "type": "stat", "title": "平均检测延迟",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 20 },
            { "color": "red", "value": 50 }
          ] }
        }
      },
      "targets": [{ "expr": "llmguard_detect_latency_avg_ms", "legendFormat": "avg latency", "datasource": "Prometheus" }]
    },
    {
      "id": 5, "type": "stat", "title": "活跃规则数",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] }
        }
      },
      "targets": [{ "expr": "llmguard_rule_count", "legendFormat": "rules", "datasource": "Prometheus" }]
    },
    {
      "id": 6, "type": "stat", "title": "热更新次数",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "cyan", "value": null }] }
        }
      },
      "targets": [{ "expr": "llmguard_rule_reloads_total", "legendFormat": "reloads", "datasource": "Prometheus" }]
    },

    {
      "id": 10, "type": "timeseries", "title": "🚦 请求 vs 拦截（实时曲线）",
      "gridPos": { "x": 0, "y": 4, "w": 16, "h": 9 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom",
          "calcs": ["mean", "max", "lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "lineWidth": 2, "fillOpacity": 12 },
        "overrides": [
          { "matcher": { "id": "byName", "options": "blocked/s" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } },
                           { "id": "fillOpacity", "value": 25 }] },
          { "matcher": { "id": "byName", "options": "requests/s" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#5794F2" } }] }
        ]
      },
      "targets": [
        { "expr": "llmguard_requests_rate1m", "legendFormat": "requests/s", "datasource": "Prometheus" },
        { "expr": "llmguard_blocked_rate1m",  "legendFormat": "blocked/s",  "datasource": "Prometheus" }
      ]
    },

    {
      "id": 11, "type": "gauge", "title": "拦截率 1min",
      "gridPos": { "x": 16, "y": 4, "w": 8, "h": 9 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": true },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.3 },
            { "color": "orange", "value": 0.5 },
            { "color": "red", "value": 0.7 }
          ] }
        }
      },
      "targets": [{ "expr": "llmguard_block_ratio_1m", "legendFormat": "", "datasource": "Prometheus" }]
    },

    {
      "id": 20, "type": "timeseries", "title": "⚡ 检测延迟分布（P50 / P95 / P99）",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "fieldConfig": {
        "defaults": { "unit": "ms", "lineWidth": 2 },
        "overrides": [
          { "matcher": { "id": "byName", "options": "P99" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "P95" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "P50" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] }
        ]
      },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(llmguard_detect_latency_ms_bucket[1m]))", "legendFormat": "P50", "datasource": "Prometheus" },
        { "expr": "histogram_quantile(0.95, rate(llmguard_detect_latency_ms_bucket[1m]))", "legendFormat": "P95", "datasource": "Prometheus" },
        { "expr": "histogram_quantile(0.99, rate(llmguard_detect_latency_ms_bucket[1m]))", "legendFormat": "P99", "datasource": "Prometheus" }
      ]
    },

    {
      "id": 21, "type": "barchart", "title": "威胁类型分布",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "options": {
        "xTickLabelRotation": 0,
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }
      },
      "targets": [
        { "expr": "increase(llmguard_blocked_by_type_total[5m])", "legendFormat": "{{threat_type}}", "datasource": "Prometheus" }
      ]
    },

    {
      "id": 30, "type": "timeseries", "title": "🔁 流式审核：chunk 处理速率",
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 7 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "cps", "lineWidth": 2 },
        "overrides": [
          { "matcher": { "id": "byName", "options": "blocked chunks/s" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "targets": [
        { "expr": "rate(llmguard_stream_chunks_total[1m])",  "legendFormat": "chunks/s",        "datasource": "Prometheus" },
        { "expr": "rate(llmguard_stream_blocked_total[1m])", "legendFormat": "blocked chunks/s", "datasource": "Prometheus" }
      ]
    },

    {
      "id": 31, "type": "timeseries", "title": "🔔 告警发送速率",
      "gridPos": { "x": 12, "y": 21, "w": 12, "h": 7 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "cps", "lineWidth": 2 }
      },
      "targets": [
        { "expr": "rate(llmguard_alerts_by_channel_total[5m])", "legendFormat": "{{channel}}", "datasource": "Prometheus" }
      ]
    },

    {
      "id": 40, "type": "timeseries", "title": "🔄 规则热更新事件",
      "gridPos": { "x": 0, "y": 28, "w": 8, "h": 6 },
      "options": { "tooltip": { "mode": "single" } },
      "fieldConfig": {
        "defaults": { "unit": "short", "lineWidth": 2, "drawStyle": "bars" }
      },
      "targets": [
        { "expr": "increase(llmguard_rule_reloads_total[1m])", "legendFormat": "reloads/min", "datasource": "Prometheus" }
      ]
    },

    {
      "id": 41, "type": "timeseries", "title": "🔎 检测引擎命中来源",
      "gridPos": { "x": 8, "y": 28, "w": 8, "h": 6 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "short", "lineWidth": 2 }
      },
      "targets": [
        { "expr": "increase(llmguard_blocked_by_source_total[1m])", "legendFormat": "{{source}}", "datasource": "Prometheus" }
      ]
    },

    {
      "id": 42, "type": "timeseries", "title": "❌ 内部错误速率",
      "gridPos": { "x": 16, "y": 28, "w": 8, "h": 6 },
      "options": { "tooltip": { "mode": "single" } },
      "fieldConfig": {
        "defaults": { "unit": "cps", "lineWidth": 2, "color": { "mode": "fixed", "fixedColor": "red" } }
      },
      "targets": [
        { "expr": "rate(llmguard_errors_total[1m])", "legendFormat": "errors/s", "datasource": "Prometheus" }
      ]
    },

    {
      "id": 50, "type": "table", "title": "延迟 Histogram（过去5分钟）",
      "gridPos": { "x": 0, "y": 34, "w": 24, "h": 7 },
      "options": { "sortBy": [{ "displayName": "Le (ms)", "desc": false }] },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Value" },
            "properties": [{ "id": "displayName", "value": "Cumulative Count" },
                           { "id": "custom.width", "value": 180 }] }
        ]
      },
      "targets": [
        { "expr": "llmguard_detect_latency_ms_bucket", "legendFormat": "Le={{le}}", "datasource": "Prometheus",
          "instant": true, "format": "table" }
      ],
      "transformations": [
        { "id": "organize", "options": {
          "renameByName": { "le": "Le (ms)", "Value": "Count" }
        }}
      ]
    }
  ],

  "annotations": {
    "list": [
      {
        "builtIn": 1, "datasource": "Prometheus",
        "enable": true, "hide": false, "iconColor": "rgba(0,211,255,1)",
        "name": "规则热更新",
        "expr": "changes(llmguard_rule_count[1m]) > 0",
        "step": "60s",
        "titleFormat": "规则热更新",
        "textFormat": "规则数变更"
      }
    ]
  },

  "templating": {
    "list": [
      {
        "name": "interval", "type": "interval", "label": "刷新间隔",
        "options": [
          { "selected": false, "text": "5s", "value": "5s" },
          { "selected": true, "text": "10s", "value": "10s" },
          { "selected": false, "text": "30s", "value": "30s" }
        ],
        "current": { "text": "10s", "value": "10s" }
      }
    ]
  }
}
