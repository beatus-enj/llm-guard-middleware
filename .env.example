# ── 上游 llama.cpp ─────────────────────────────────────────────────────────
UPSTREAM_URL=http://localhost:8080
UPSTREAM_TIMEOUT=120.0

# ── 中间件监听 ────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── 功能开关 ──────────────────────────────────────────────────────────────
ENABLE_RULE_ENGINE=true
ENABLE_ML_MODEL=false          # true 时需安装 transformers + torch
ENABLE_STREAM_GUARD=true
ENABLE_HOT_RELOAD=true
HOT_RELOAD_POLL_SEC=2.0

# ── ML 模型 ───────────────────────────────────────────────────────────────
ML_MODEL_NAME=unitary/toxic-bert
ML_MODEL_CACHE_DIR=./model_cache
ML_THRESHOLD=0.7
ML_INJECTION_THRESHOLD=0.65

# ── 安全回复 ──────────────────────────────────────────────────────────────
SAFE_REPLY_MESSAGE=很抱歉，您的请求包含不当内容，无法处理。如有疑问请联系管理员。

# ── 规则文件 ──────────────────────────────────────────────────────────────
RULES_CONFIG=./config/rules.yaml

# ── 告警：通用配置 ────────────────────────────────────────────────────────
ALERT_BLOCK_RATIO_THRESHOLD=0.5   # 1分钟内拦截率超过该值触发告警
ALERT_COOLDOWN_SEC=300            # 同类告警冷却时间（秒）

# ── 告警：Webhook（企业微信 / 飞书 / 钉钉 / 自定义）──────────────────────
# ALERT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# ALERT_WEBHOOK_TYPE=wecom        # wecom | feishu | dingtalk | generic

# ── 告警：SMTP 邮件 ───────────────────────────────────────────────────────
# ALERT_SMTP_HOST=smtp.example.com
# ALERT_SMTP_PORT=587
# ALERT_SMTP_TLS=true
# ALERT_SMTP_USER=user@example.com
# ALERT_SMTP_PASSWORD=secret
# ALERT_SMTP_FROM=llm-guard@example.com
# ALERT_SMTP_TO=security@example.com
